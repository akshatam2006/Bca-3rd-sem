CREATE DATABASE EMPLOYEEDB1;
USE EMPLOYEEDB1;
CREATE TABLE EMPLOYEE (
EMPID INT,
ENAME VARCHAR(10),
EMPSAL int);
INSERT INTO EMPLOYEE VALUES 
(101, 'RAMESH',25000),
(102,'PRIYA',30000),
(103,'SURESH',20000),
(104,'ANU',45000),
(105,'KIRAN',35000);

SELECT*FROM EMPLOYEE;
SELECT ENAME
FROM EMPLOYEE
WHERE EMPSAL=(
SELECT MAX(EMPSAL)
FROM EMPLOYEE
);